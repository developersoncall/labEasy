# Supabase (required) — Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Show the demo/dummy login cards on /login in a production build.
# They are always visible in `npm run dev`.
VITE_SHOW_DEMO_LOGINS=false
